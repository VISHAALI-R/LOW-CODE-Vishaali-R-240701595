 * Generated on : 10-Nov-2026 15:26:57
 * Version      : 1.0
 */
 application "ScholarEase 1"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form AI_Scholarship_Recommendations
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			AI_Scholarship_Recommendations
			(
				type = picklist	
				displayname = "Select student"
				values  = Form_1_Student_Details.ID
    			displayformat = [" " + Student_Name.prefix + " " + Student_Name.first_name + " " + Student_Name.last_name + " " + Student_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Recommendation_Request
			(
    			type = textarea
				displayname = "Recommendation Request"
				height = 100px
    			description
    			[
    				type = tooltip
    			 	message = "Enter any questions or preferences about scholarship opportunities."
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Recommendation
			(
    			type = textarea
				displayname = "AI Recommendation"
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recommendation_Date
			(
    			type = date
				displayname = "Recommendation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Application_Review
		{
			displayname = "Application Review"
			success message = "Application Review Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Application
			(
				type = picklist	
				values  = Scholarship_Application.ID
    			displayformat = [Application_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reviewer
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Decision
			(
				type = picklist
				maxchar = 100
				values = {"Approved","Rejected","Additional Document Needed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Review_Date
			(
    			type = date
				displayname = "Review Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Form_1_Student_Details
		{
			displayname = "Form 1: Student Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student_Name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Student_ID
			(
    			type = text
				displayname = "Student ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"CSE","ECE","IT","EEE","CIVIL","CSBS"}
				initial value = "ECE"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_of_Study
			(
				type = picklist
				displayname = "Year of Study"
				maxchar = 100
				values = {"1st year","2nd year","3rd year","4th year"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CGPA
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Annual_Family_Income
			(
				displayname = "Annual Family Income"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Scholarship_Application
		{
			displayname = "Scholarship Application"
			success message = "Scholarship Application Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Student
			(
				type = picklist	
				values  = Scholarship_Details.ID
    			displayformat = [" - " + ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Scholarship
			(
				type = picklist	
				values  = Scholarship_Details.ID
    			displayformat = [Scholarship_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supporting_Document
			(
    			type = upload file
				displayname = "Supporting Document"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certificate_Image
			(
    			type = image
				displayname = "Certificate Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Eligibility_Status
			(
				type = picklist
				displayname = "Eligibility Status"
				maxchar = 100
				values = {"Pending Check","Eligible","Not Eligible"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Review_Status
			(
				type = picklist
				displayname = "Review Status"
				maxchar = 100
				values = {"Pending","Under Review","Approved","Rejected","Additional Documents Required"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Date
			(
    			type = date
				displayname = "Application Date"
				initial value = "13-Oct-2026"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Form_1_Student_Details
			(
				type = picklist	
				displayname = "Form 1: Student Details"
				values  = Form_1_Student_Details.ID
    			displayformat = [" " + Student_Name.first_name + " " + Student_Name.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR
			(
    			type = textarea
				displayname = "Extracted Certificate Text"
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									basefield = Certificate_Image
						)
			)
			Document_Verification_Status
			(
				type = picklist
				displayname = "Document Verification Status"
				maxchar = 100
				values = {"pending","verified","rejected"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Scholarship_Details
		{
			displayname = "Scholarship Details"
			success message = "Scholarship Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Scholarship_Name
			(
    			type = text
				displayname = "Scholarship Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Scholarship_Type
			(
				type = picklist
				displayname = "Scholarship Type"
				maxchar = 100
				values = {"Merit-Based","Need-Based","Academic Excellence"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Minimum_CGPA
			(
				type = decimal
				displayname = "Minimum CGPA"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Maximum_Family_Income
			(
				displayname = "Maximum Family Income"
				type = INR
				format = commadotindian
				decimalplace = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Scholarship_Amount
			(
				displayname = "Scholarship Amount"
				type = INR
				format = commadotindian
				decimalplace = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Application_Deadline
			(
    			type = date
				displayname = "Application Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Form_1_Student_Details_Report
		{
			displayName = "Form 1: Student Details Report"
			show all rows from Form_1_Student_Details    
			(
				Student_Name  as "Student Name"
				Email
				Student_ID as "Student ID"
				Department
				Year_of_Study as "Year of Study"
				CGPA
				Annual_Family_Income as "Annual Family Income"
			)
		}
		default list All_Scholarship_Details
		{
			displayName = "All Scholarship Details"
			show all rows from Scholarship_Details    
			(
				Scholarship_Name as "Scholarship Name"
				Scholarship_Type as "Scholarship Type"
				Minimum_CGPA as "Minimum CGPA"
				Maximum_Family_Income as "Maximum Family Income"
				Scholarship_Amount as "Scholarship Amount"
				Application_Deadline as "Application Deadline"
			)
		}
		default list All_Scholarship_Applications
		{
			displayName = "All Scholarship Applications"
			show all rows from Scholarship_Application    
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
				Certificate_Image as "Certificate Image"
				OCR as "Extracted Certificate Text"
				Document_Verification_Status as "Document Verification Status"
			)
		}
		default list All_Application_Reviews
		{
			displayName = "All Application Reviews"
			show all rows from Application_Review    
			(
				Application
				Reviewer
				Decision
				Review_Date as "Review Date"
			)
		}
		list Eligible_Applications_Report
		{
			displayName = "Eligible Applications Report"
			show all rows from Scholarship_Application  [Eligibility_Status == "Eligible"]  
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
			)
		}
		list Approved_Applications_Report
		{
			displayName = "Approved Applications Report"
			show all rows from Scholarship_Application  [Review_Status == "Approved"]  
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
			)
		}
		list Rejected_Applications_Report
		{
			displayName = "Rejected Applications Report"
			show all rows from Scholarship_Application  [Review_Status == "Rejected"]  
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
			)
		}
		list Pending_Reviews_Report
		{
			displayName = "Pending Reviews Report"
			show all rows from Scholarship_Application  [Review_Status == "Pending"]  
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
			)
		}
		default list AI_Scholarship_Recommendations_Report
		{
			displayName = "AI_Scholarship_Recommendations Report"
			show all rows from AI_Scholarship_Recommendations    
			(
				AI_Scholarship_Recommendations as "Select student"
				Recommendation_Request as "Recommendation Request"
				AI_Recommendation as "AI Recommendation"
				Recommendation_Date as "Recommendation Date"
			)
		}
		list Certificate_Verification_Report
		{
			displayName = "Certificate Verification Report"
			show all rows from Scholarship_Application    
			(
				Application_ID as "Application ID"
				Student
				Scholarship
				Supporting_Document as "Supporting Document"
				Certificate_Image as "Certificate Image"
				Eligibility_Status as "Eligibility Status"
				Review_Status as "Review Status"
				Application_Date as "Application Date"
				Form_1_Student_Details as "Form 1: Student Details"
				OCR as "Extracted Certificate Text"
				Document_Verification_Status as "Document Verification Status"
			)
		}
	}
	pages
	{
		page Scholarship_Dashboard
		{
			displayname = "Scholarship Dashboard."
