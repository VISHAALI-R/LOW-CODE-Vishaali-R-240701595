\t\t width='100%'\n   \t>\n\t<panel elementName='how_it_works.setup-hero.outlined.comfortable'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#F0F0F0'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '8px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '12px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'HOW IT WORKS'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='8px'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#1C1C1C'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Simple 3-Step Process'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='1px'\n>\n\t<pc \n\t\tbgColor = '#F7F7F7'\n\n\t\twidth = '100%'\n>\n\t\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '40px'\n\tpaddingLeft = '24px'\n\tpaddingRight = '24px'\n\tpaddingBottom = '24px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '33.33%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<image  \n\t\n\tcolor = '#575757'\n\tbgColor = '#F7F7F7'\n\twidth = '20px'\n\theight = '20px'\n\ttype = 'icon'\n\tvalue = 'ui-2-fat-add'\n\tsize = '12px'\n\tcornerRadius = '10px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpaddingLeft = '10px'\n\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Explore Scholarships'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\n\t\twidth = '33.33%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<image  \n\t\n\tcolor = '#575757'\n\tbgColor = '#F7F7F7'\n\twidth = '20px'\n\theight = '20px'\n\ttype = 'icon'\n\tvalue = 'ui-2-fat-add'\n\tsize = '12px'\n\tcornerRadius = '10px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpaddingLeft = '10px'\n\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Submit Application'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\n\t\twidth = '33.34%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<image  \n\t\n\tcolor = '#575757'\n\tbgColor = '#F7F7F7'\n\twidth = '20px'\n\theight = '20px'\n\ttype = 'icon'\n\tvalue = 'ui-2-fat-add'\n\tsize = '12px'\n\tcornerRadius = '10px'\n\ticonType = 'solid'\n/>\n</pc><pc \n\t\tpaddingLeft = '10px'\n\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<text \n\n\tcolor = '#575757'\n\tsize = '13px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Track Your Application'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='AI_Assistant_Chatbot_dsp' elementName='AI Assistant Chatbot'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage AI_Assistant_Chatbot_dsp()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n  .scholar-ease-chat-container {\n    font-family: &apos;Segoe UI&apos;, Tahoma, Geneva, Verdana, sans-serif;\n    max-width: 800px;\n    margin: 0 auto;\n    background-color: #ffffff;\n    border-radius: 12px;\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    height: 600px;\n  }\n  \n  .chat-header {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    color: white;\n    padding: 20px;\n    text-align: center;\n  }\n  \n  .chat-header h2 {\n    margin: 0;\n    font-size: 24px;\n    font-weight: 600;\n  }\n  \n  .chat-header p {\n    margin: 5px 0 0;\n    font-size: 14px;\n    opacity: 0.9;\n  }\n  \n  .chat-messages {\n    flex: 1;\n    padding: 20px;\n    overflow-y: auto;\n    background-color: #f8f9fa;\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n  }\n  \n  .message {\n    max-width: 70%;\n    padding: 12px 16px;\n    border-radius: 18px;\n    position: relative;\n    line-height: 1.5;\n    font-size: 15px;\n  }\n  \n  .message.ai {\n    align-self: flex-start;\n    background-color: #e9ecef;\n    color: #333;\n    border-bottom-left-radius: 4px;\n  }\n  \n  .message.user {\n    align-self: flex-end;\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    color: white;\n    border-bottom-right-radius: 4px;\n  }\n  \n  .message-time {\n    font-size: 11px;\n    margin-top: 5px;\n    opacity: 0.7;\n    text-align: right;\n  }\n  \n  .chat-input-area {\n    padding: 15px;\n    background-color: white;\n    border-top: 1px solid #e9ecef;\n    display: flex;\n    gap: 10px;\n    align-items: center;\n  }\n  \n  .chat-input {\n    flex: 1;\n    padding: 12px 15px;\n    border: 1px solid #ddd;\n    border-radius: 25px;\n    font-size: 15px;\n    outline: none;\n    transition: border-color 0.3s;\n  }\n  \n  .chat-input:focus {\n    border-color: #667eea;\n  }\n  \n  .btn {\n    padding: 10px 20px;\n    border: none;\n    border-radius: 25px;\n    cursor: pointer;\n    font-size: 14px;\n    font-weight: 500;\n    transition: all 0.3s;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  \n  .btn-send {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    color: white;\n  }\n  \n  .btn-send:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 4px 10px rgba(102, 126, 234, 0.4);\n  }\n  \n  .btn-clear {\n    background-color: #f8f9fa;\n    color: #666;\n    border: 1px solid #ddd;\n  }\n  \n  .btn-clear:hover {\n    background-color: #e9ecef;\n  }\n  \n  .icon {\n    font-style: normal;\n  }\n  \n  @media (max-width: 600px) {\n    .scholar-ease-chat-container {\n      height: 100vh;\n      border-radius: 0;\n    }\n    \n    .message {\n      max-width: 85%;\n    }\n    \n    .chat-header h2 {\n      font-size: 20px;\n    }\n  }\n&lt;/style&gt;\n\n&lt;div class=&quot;scholar-ease-chat-container&quot;&gt;\n  &lt;div class=&quot;chat-header&quot;&gt;\n    &lt;h2&gt;ScholarEase AI Assistant&lt;/h2&gt;\n    &lt;p&gt;Your smart companion for scholarship guidance.&lt;/p&gt;\n  &lt;/div&gt;\n  \n  &lt;div class=&quot;chat-messages&quot; id=&quot;chatMessages&quot;&gt;\n    &lt;div class=&quot;message ai&quot;&gt;\n      &lt;div&gt;Hello! I&apos;m your ScholarEase AI Assistant. How can I help you with your scholarship applications today?&lt;/div&gt;\n      &lt;div class=&quot;message-time&quot;&gt;&lt;%=zoho.currenttime%&gt;&lt;/div&gt;\n    &lt;/div&gt;\n  &lt;/div&gt;\n  \n  &lt;div class=&quot;chat-input-area&quot;&gt;\n    &lt;input type=&quot;text&quot; class=&quot;chat-input&quot; id=&quot;messageInput&quot; placeholder=&quot;Type your message here...&quot;&gt;\n    &lt;button class=&quot;btn btn-send&quot; onclick=&quot;sendMessage()&quot;&gt;\n      &lt;span class=&quot;icon&quot;&gt;&amp;#10148;&lt;/span&gt; Send\n    &lt;/button&gt;\n    &lt;button class=&quot;btn btn-clear&quot; onclick=&quot;clearChat()&quot;&gt;\n      &lt;span class=&quot;icon&quot;&gt;&amp;#128465;&lt;/span&gt; Clear Chat\n    &lt;/button&gt;\n  &lt;/div&gt;\n&lt;/div&gt;\n\n&lt;script&gt;\n  function sendMessage() {\n    var input = document.getElementById(&apos;messageInput&apos;);\n    var message = input.value.trim();\n    \n    if (message === &apos;&apos;) return;\n    \n    var chatMessages = document.getElementById(&apos;chatMessages&apos;);\n    \n    // Add user message\n    var userMsgDiv = document.createElement(&apos;div&apos;);\n    userMsgDiv.className = &apos;message user&apos;;\n    userMsgDiv.innerHTML = &apos;&lt;div&gt;&apos; + message + &apos;&lt;/div&gt;&lt;div class=&quot;message-time&quot;&gt;&apos; + new Date().toLocaleTimeString([], {hour: &apos;2-digit&apos;, minute:&apos;2-digit&apos;}) + &apos;&lt;/div&gt;&apos;;\n    chatMessages.appendChild(userMsgDiv);\n    \n    // Clear input\n    input.value = &apos;&apos;;\n    \n    // Scroll to bottom\n    chatMessages.scrollTop = chatMessages.scrollHeight;\n    \n    // Simulate AI response (In a real scenario, this would call an AI service)\n    setTimeout(function() {\n      var aiMsgDiv = document.createElement(&apos;div&apos;);\n      aiMsgDiv.className = &apos;message ai&apos;;\n      aiMsgDiv.innerHTML = &apos;&lt;div&gt;Thank you for your question about scholarships. I can help you with eligibility criteria, application deadlines, and required documents. Could you please specify which scholarship you are interested in?&lt;/div&gt;&lt;div class=&quot;message-time&quot;&gt;&apos; + new Date().toLocaleTimeString([], {hour: &apos;2-digit&apos;, minute:&apos;2-digit&apos;}) + &apos;&lt;/div&gt;&apos;;\n      chatMessages.appendChild(aiMsgDiv);\n      chatMessages.scrollTop = chatMessages.scrollHeight;\n    }, 1000);\n  }\n  \n  function clearChat() {\n    var chatMessages = document.getElementById(&apos;chatMessages&apos;);\n    chatMessages.innerHTML = &apos;&lt;div class=&quot;message ai&quot;&gt;&lt;div&gt;Hello! I\\&apos;m your ScholarEase AI Assistant. How can I help you with your scholarship applications today?&lt;/div&gt;&lt;div class=&quot;message-time&quot;&gt;&apos;+ new Date().toLocaleTimeString([], {hour: &apos;2-digit&apos;, minute:&apos;2-digit&apos;}) + &apos;&lt;/div&gt;&lt;/div&gt;&apos;;\n  }\n  \n  // Allow sending message with Enter key\n  document.getElementById(&apos;messageInput&apos;).addEventListener(&apos;keypress&apos;, function(e) {\n    if (e.key === &apos;Enter&apos;) {\n      sendMessage();\n    }\n  });\n&lt;/script&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 string Get_Application_Status()
                 {
                 	result = "";
                 	studentRecord = Form_1_Student_Details[Email == zoho.loginuserid];
                 	if(studentRecord.ID != null)
                 	{
                 		result = "YOUR SCHOLARSHIP APPLICATIONS\n\n";
                 		applicationFound = false;
                 		for each  application in Scholarship_Application
                 		{
                 			if(application.Form_1_Student_Details == studentRecord.ID)
                 			{
                 				applicationFound = true;
                 				result = result + "Application ID: " + application.ID + "\n";
                 				result = result + "Eligibility Status: " + application.Eligibility_Status + "\n";
                 				result = result + "Review Status: " + application.Review_Status + "\n\n";
                 			}
                 		}
                 		if(applicationFound == false)
                 		{
                 			result = "You have not submitted any scholarship applications yet.";
                 		}
                 	}
                 	else
                 	{
                 		result = "Student profile not found.";
                 	}
                 	return result;
                 }
				 string Get_Eligibility_Info()
                 {
                 	result = "SCHOLARSHIP ELIGIBILITY REQUIREMENTS\n\n";
                 	for each  scholarship in Scholarship_Details
                 	{
                 		result = result + "Scholarship: " + scholarship.Scholarship_Name + "\n";
                 		result = result + "Minimum CGPA Required: " + scholarship.Minimum_CGPA + "\n";
                 		result = result + "Maximum Family Income: " + scholarship.Maximum_Family_Income + "\n";
                 		result = result + "Application Deadline: " + scholarship.Application_Deadline + "\n\n";
                 	}
                 	return result;
                 }
				 string Get_scholarship_data(int student_id)
                 {
                 	result = "";
                 	studentRecord = Form_1_Student_Details[ID == student_id];
                 	if(studentRecord.ID != null)
                 	{
                 		result = "STUDENT DETAILS\n";
                 		result = result + "Name: " + studentRecord.Student_Name + "\n";
                 		result = result + "CGPA: " + studentRecord.CGPA + "\n";
                 		result = result + "Annual Family Income: " + studentRecord.Annual_Family_Income + "\n";
                 		result = result + "Department: " + studentRecord.Department + "\n";
                 		result = result + "Year: " + studentRecord.Year_of_Study + "\n\n";
                 		result = result + "AVAILABLE SCHOLARSHIPS\n";
                 		for each  scholarship in Scholarship_Details
                 		{
                 			if(studentRecord.CGPA >= scholarship.Minimum_CGPA && studentRecord.Annual_Family_Income <= scholarship.Maximum_Family_Income && scholarship.Application_Deadline >= zoho.currentdate)
                 			{
                 				result = result + "Scholarship: " + scholarship.Scholarship_Name + "\n";
                 				result = result + "Type: " + scholarship.Scholarship_Type + "\n";
                 				result = result + "Amount: " + scholarship.Scholarship_Amount + "\n\n";
                 			}
                 		}
                 	}
                 	else
                 	{
                 		result = "Student record not found.";
                 	}
                 	return result;
                 }
				 string Get_Scholarship_Info()
                 {
                 	result = "AVAILABLE SCHOLARSHIPS\n\n";
                 	for each  scholarship in Scholarship_Details
                 	{
                 		result = result + "Scholarship Name: " + scholarship.Scholarship_Name + "\n";
                 		result = result + "Scholarship Type: " + scholarship.Scholarship_Type + "\n";
                 		result = result + "Minimum CGPA: " + scholarship.Minimum_CGPA + "\n";
                 		result = result + "Maximum Family Income: " + scholarship.Maximum_Family_Income + "\n";
                 		result = result + "Scholarship Amount: " + scholarship.Scholarship_Amount + "\n";
                 		result = result + "Application Deadline: " + scholarship.Application_Deadline + "\n\n";
                 	}
                 	return result;
                 }
				 string Get_Student_Info()
                 {
                 	result = "";
                 	studentRecord = Form_1_Student_Details[Email == zoho.loginuserid];
                 	if(studentRecord.ID != null)
                 	{
                 		result = "STUDENT DETAILS\n";
                 		result = result + "Name: " + studentRecord.Student_Name + "\n";
                 		result = result + "Email: " + studentRecord.Email + "\n";
                 		result = result + "Department: " + studentRecord.Department + "\n";
                 		result = result + "Year: " + studentRecord.Year_of_Study + "\n";
                 		result = result + "CGPA: " + studentRecord.CGPA + "\n";
                 		result = result + "Annual Family Income: " + studentRecord.Annual_Family_Income;
                 	}
                 	else
                 	{
                 		result = "No student profile found for this account.";
                 	}
                 	return result;
                 }
				 string ScholarEase_Chatbot(string user_message)
                 {
                 	result = "";
                 	question = user_message.toLowerCase();
                 	if(question.contains("scholarship"))
                 	{
                 		result = thisapp.Get_Scholarship_Info();
                 	}
                 	else if(question.contains("eligibility") || question.contains("cgpa"))
                 	{
                 		result = thisapp.Get_Eligibility_Info();
                 	}
                 	else if(question.contains("application") || question.contains("status"))
                 	{
                 		result = thisapp.Get_Application_Status();
                 	}
                 	else if(question.contains("my details") || question.contains("my profile"))
                 	{
                 		result = thisapp.Get_Student_Info();
                 	}
                 	else
                 	{
                 		result = "Hello! I can help you with available scholarships, eligibility requirements, student details and application status. What would you like to know?";
                 	}
                 	return result;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Check_Scholarship_Eligibi as "Check_Scholarship_Eligibility"
			{
				type =  form
				form = Scholarship_Application

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Form_1_Student_Details != null && input.Scholarship != null && input.Application_Date != null)
										{
											studentRecord = Form_1_Student_Details[ID == input.Form_1_Student_Details.toLong()];
											scholarshipRecord = Scholarship_Details[ID == input.Scholarship.toLong()];
											eligibility = "Not Eligible";
											if(studentRecord.count() > 0 && scholarshipRecord.count() > 0)
											{
												if(studentRecord.CGPA != null && studentRecord.Annual_Family_Income != null && scholarshipRecord.Minimum_CGPA != null && scholarshipRecord.Maximum_Family_Income != null && scholarshipRecord.Application_Deadline != null)
												{
													if(studentRecord.CGPA >= scholarshipRecord.Minimum_CGPA && studentRecord.Annual_Family_Income <= scholarshipRecord.Maximum_Family_Income && input.Application_Date <= scholarshipRecord.Application_Deadline)
													{
														eligibility = "Eligible";
													}
												}
											}
											input.Eligibility_Status = eligibility;
										}
						)
					}
				}

			}
			Update_Scholarship_Eligib as "Update_Scholarship_Eligibility"
			{
				type =  form
				form = Scholarship_Application

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											eligibilityStatus = "Pending Check";
										if(input.Form_1_Student_Details != null && input.Scholarship != null && input.Application_Date != null)
										{
											studentRecord = Form_1_Student_Details[ID == input.Form_1_Student_Details];
											scholarshipRecord = Scholarship_Details[ID == input.Scholarship];
											if(studentRecord.ID != null && scholarshipRecord.ID != null)
											{
												if(studentRecord.CGPA != null && studentRecord.Annual_Family_Income != null && scholarshipRecord.Minimum_CGPA != null && scholarshipRecord.Maximum_Family_Income != null && scholarshipRecord.Application_Deadline != null)
												{
													if(studentRecord.CGPA >= scholarshipRecord.Minimum_CGPA && studentRecord.Annual_Family_Income <= scholarshipRecord.Maximum_Family_Income && input.Application_Date <= scholarshipRecord.Application_Deadline)
													{
														eligibilityStatus = "Eligible";
													}
													else
													{
														eligibilityStatus = "Not Eligible";
													}
												}
											}
										}
										input.Eligibility_Status = eligibilityStatus;
						)
					}
				}

			}
			Update_Application_Review as "Update_Application_Review_Status"
			{
				type =  form
				form = Application_Review

				record event = on add

				on success
				{
				}

			}
			Update_Application_Review1 as "Update_Application_Review_Status"
			{
				type =  form
				form = Application_Review

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Application != null && input.Decision != null)
										{
											applicationID = input.Application;
											decisionText = input.Decision.toString().trim();
											if(decisionText == "Approved")
											{
												applicationRecord = Scholarship_Application[ID == applicationID];
												applicationRecord.Review_Status="Approved";
											}
											else if(decisionText == "Rejected")
											{
												applicationRecord = Scholarship_Application[ID == applicationID];
												applicationRecord.Review_Status="Rejected";
											}
											else if(decisionText == "Additional Document Needed")
											{
												applicationRecord = Scholarship_Application[ID == applicationID];
												applicationRecord.Review_Status="Additional Documents Required";
											}
										}
						)
					}
				}

			}
			Application_Submitted_Ema as "Application Submitted Email"
			{
				type =  form
				form = Scholarship_Application

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "vishaali.r.2024.cse@rajalakshmi.edu.in"
							to : "vishaalimoni05@gmail.com"
							subject : "Record ScholarEase - New Scholarship Application ReceivedAdded"
							message : "<blockquote><blockquote><blockquote><p class=\"PDq2pG_selectionAnchorContainer\" data-end=\"382\" data-start=\"369\" dir=\"auto\">Dear Student,<br></p></blockquote></blockquote></blockquote><p data-end=\"465\" data-start=\"384\" dir=\"auto\">Your scholarship application has been submitted successfully through ScholarEase.<br></p><p data-end=\"599\" data-start=\"467\" dir=\"auto\">Your application will be reviewed by the scholarship administration team. Please keep your application details for future reference.<br></p><p data-end=\"633\" data-start=\"601\" dir=\"auto\">Thank you for using ScholarEase!<br></p><p data-end=\"677\" data-start=\"635\" dir=\"auto\">Regards,<br></p><div><br></div>"
							content type : Plain Text
							attachments : template : _default as inline
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Form_1_Student_Details != null)
										{
											studentRecord = Form_1_Student_Details[ID == input.Form_1_Student_Details];
											if(studentRecord.ID != null && studentRecord.Email != null)
											{
												studentEmail = studentRecord.Email;
												info studentEmail;
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(input.Form_1_Student_Details != null)
										{
											studentRecord = Form_1_Student_Details[ID == input.Form_1_Student_Details];
											if(studentRecord.ID != null && studentRecord.Email != null)
											{
												sendmail
												[
													from :zoho.adminuserid
													to :studentRecord.Email
													subject :"ScholarEase - Application Submitted Successfully"
													message :"Dear Student, your scholarship application has been submitted successfully. Your Application ID is " + input.ID + ". Please log in to ScholarEase to check your application status."
												]
											}
										}
						)
					}
				}

			}
