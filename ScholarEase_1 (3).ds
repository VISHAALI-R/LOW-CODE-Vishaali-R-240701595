			Generate_AI_Scholarship_R as "Generate AI Scholarship Recommendation"
			{
				type =  form
				form = AI_Scholarship_Recommendations

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											studentID = input.AI_Scholarship_Recommendations;
										if(studentID != null)
										{
											studentRecord = Form_1_Student_Details[ID == studentID];
											if(studentRecord.ID != null)
											{
												// Fetch student information
												studentCGPA = studentRecord.CGPA;
												studentIncome = studentRecord.Annual_Family_Income;
												// Fetch available scholarships
												scholarshipText = "";
												scholarshipList = Scholarship_Details[ID != 0];
												for each  scholarship in scholarshipList
												{
													scholarshipText = scholarshipText + "\nScholarship: " + scholarship.Scholarship_Name + "\nType: " + scholarship.Scholarship_Type + "\nMinimum CGPA: " + scholarship.Minimum_CGPA + "\nMaximum Family Income: " + scholarship.Maximum_Family_Income + "\nAmount: " + scholarship.Scholarship_Amount + "\nDeadline: " + scholarship.Application_Deadline + "\n";
												}
												// Build AI prompt
												promptText = "You are a scholarship recommendation assistant." + "\nStudent CGPA: " + studentCGPA + "\nAnnual Family Income: " + studentIncome + "\nStudent Request: " + input.Recommendation_Request + "\nAvailable Scholarships: " + scholarshipText + "\nRecommend suitable scholarships based on the student's profile." + "\nExplain why each scholarship is suitable." + "\nMention unmet eligibility conditions." + "\nNever guarantee scholarship approval." + "\nUse simple and understandable language.";
												// Prepare OpenAI request
												requestBody = Map();
												requestBody.put("model","gpt-4.1-mini");
												requestBody.put("input",promptText);
												requestBody.put("max_output_tokens",700);
												// Call OpenAI API
												apiResponse = invokeurl
												[
													url :"https://api.openai.com/v1/responses"
													type :POST
													body:requestBody.toString()
													headers:{"Content-Type":"application/json"}
													connection:"openai_connection"
												];
												info apiResponse;
												recommendationText = "";
												// Extract AI response
												if(apiResponse != null)
												{
													outputList = apiResponse.get("output");
													if(outputList != null)
													{
														for each  outputItem in outputList
														{
															if(outputItem.get("type") == "message")
															{
																contentList = outputItem.get("content");
																if(contentList != null)
																{
																	for each  contentItem in contentList
																	{
																		if(contentItem.get("type") == "output_text")
																		{
																			recommendationText = recommendationText + contentItem.get("text");
																		}
																	}
																}
															}
														}
													}
												}
												// Save AI recommendation
												if(recommendationText != "")
												{
													recommendationRecord = AI_Scholarship_Recommendations[ID == input.ID];
													recommendationRecord.AI_Recommendation=recommendationText;
													recommendationRecord.Recommendation_Date=zoho.currentdate;
													info "AI recommendation saved successfully.";
												}
												else
												{
													info "AI recommendation is empty. Check the API response above.";
												}
											}
										}
						)
					}
				}

			}
		}






