											applicationRecord = Scholarship_Application[ID == input.Application];
											if(applicationRecord.ID != null && applicationRecord.Form_1_Student_Details != null)
											{
												studentRecord = Form_1_Student_Details[ID == applicationRecord.Form_1_Student_Details];
												if(studentRecord.ID != null && studentRecord.Email != null)
												{
													sendmail
													[
														from :zoho.adminuserid
														to :studentRecord.Email
														subject :"ScholarEase - Scholarship Application Update"
														message :"We regret to inform you that your scholarship application has been rejected. Please log in to ScholarEase to view your application details or contact the scholarship administration team if you have questions."
													]
												}
											}
										}
						)
					}
				}

