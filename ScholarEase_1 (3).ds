				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Application != null && input.Decision == "Additional Document Needed")
										{
											applicationRecord = Scholarship_Application[ID == input.Application];
											if(applicationRecord.ID != null && applicationRecord.Form_1_Student_Details != null)
											{
												studentRecord = Form_1_Student_Details[ID == applicationRecord.Form_1_Student_Details];
												if(studentRecord.ID != null && studentRecord.Email != null)
												{
													sendmail
													[
														from :zoho.adminuserid
														to :studentRecord.Email
														subject :"ScholarEase - Additional Documents Required"
														message :"Dear Student,\n\nYour scholarship application requires additional supporting documents. Please log in to ScholarEase and check the requirements. Upload the requested documents and contact the scholarship administration team if you need assistance.\n\nRegards,\nScholarEase Administration Team"
													]
												}
